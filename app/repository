<?php

namespace App\Repositories;

interface TaskRepositoryInterface
{
    // Devuelve un array con todas las tareas
    public function all(): array;

    // Busca y devuelve una tarea por su ID, o null si no existe
    public function find(int $id): ?array;

    // Crea una nueva tarea y la devuelve
    public function create(array $data): array;

    // Actualiza una tarea existente y la devuelve, o null si no existe
    public function update(int $id, array $data): ?array;

    // Elimina una tarea por su ID y devuelve true si se eliminó, false si no se encontró
    public function delete(int $id): bool;
}
